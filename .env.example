# ───────── Site ─────────
# Sitenin dış adresi (e-postalardaki linkler bunu kullanır). Sonunda / olmasın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Veritabanı (Supabase Postgres) ─────────
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
# Yerel geliştirme için: `npm run db:dev` → postgres://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=postgres://postgres.xxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ───────── Supabase Storage (dekontlar) ─────────
# Boş bırakılırsa (yalnızca yerelde) dekontlar .dev-data/receipts klasörüne yazılır.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts

# ───────── E-posta (Resend) ─────────
# Boş bırakılırsa (yalnızca yerelde) e-postalar .dev-data/outbox klasörüne yazılır.
RESEND_API_KEY=
# Resend'de doğrulanmış bir alan adından olmalı
EMAIL_FROM="P-PACK 2027 <tickets@example.com>"
EMAIL_REPLY_TO=tickets@example.com
# Yeni ödeme bildirimi gelince haber verilecek adminler (virgülle)
ADMIN_NOTIFY_EMAILS=admin1@example.com,admin2@example.com

# ───────── Gizli anahtarlar (en az 32 karakter) ─────────
# Üretmek için: openssl rand -hex 32
# DİKKAT: TICKET_SECRET biletler gönderildikten sonra değiştirilirse eski biletler geçersiz olur.
TICKET_SECRET=
SESSION_SECRET=

# ───────── Adminler ve kapı personeli ─────────
# Biçim: kullanici:bcrypt_hash,kullanici2:bcrypt_hash
# Hash üretmek için: npm run hash-password -- kaan "sifre"
# .env dosyalarında hash içindeki her $ işaretinin önüne \ koyun (betik hazır halini yazdırır).
# Vercel'in Environment Variables ekranına ise \ OLMADAN yapıştırın.
ADMIN_USERS=
# Kapı (check-in) şifresi: npm run hash-password -- "kapi-sifresi"
CHECKIN_PASSWORD_HASH=
