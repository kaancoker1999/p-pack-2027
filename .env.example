# ───────── Site ─────────
# Sitenin dış adresi (paylaşım önizlemeleri için). Sonunda / olmasın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Depolama ─────────
# Netlify'da kayıtlar Netlify Blobs'ta saklanır; ayar gerekmez.
# Kendi bilgisayarınızda 1 yapın: kayıtlar .dev-data/store klasörüne yazılır.
LOCAL_STORE=1

# ───────── Oturum anahtarı (en az 32 karakter) ─────────
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=

# ───────── Adminler ─────────
# Biçim: kullanici:bcrypt_hash,kullanici2:bcrypt_hash
# Hash üretmek için: npm run hash-password -- kaan "sifre"
# .env dosyalarında hash içindeki her $ işaretinin önüne \ koyun (betik hazır halini yazdırır).
# Netlify'a girerken (netlify env:set ya da panel) \ OLMADAN yazın.
ADMIN_USERS=
